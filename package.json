{
  "name": "beatstreets-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Beat Streets — a TypeScript web port (Vite + React + Canvas/WebGL) of the beatstreets game from the Code the Classics Python monorepo. Data-driven via a typed DSL, verified by Vitest + Playwright acceptance tests, component library in Storybook.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:engine && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:engine && tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:engine && vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run build:engine && storybook build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fidelity": "node scripts/fidelity.mjs",
    "e2e:screenshot": "playwright test --project=screenshots",
    "deploy": "echo 'Deploy handled by GitHub Actions (.github/workflows/pages.yml)'",
    "build:engine": "npm run build --workspace @beatstreets/engine",
    "test:engine": "npm run test --workspace @beatstreets/engine",
    "precommit": "npm run typecheck && npm run lint && npm test && npm run build && playwright test --project=chromium --workers=1 e2e/fidelity.spec.ts e2e/fidelity-action.spec.ts e2e/game-canvas.spec.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@beatstreets/engine": "0.1.0",
    "react": "^18.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.46.0",
    "@storybook/addon-docs": "^8.2.0",
    "@storybook/addon-links": "^8.2.0",
    "@storybook/addon-viewport": "^8.2.0",
    "@storybook/react-vite": "^8.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "storybook": "^8.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "zod-validation-error": "^4.0.2"
  }
}
